# binnenvaart-mcp is KEYLESS by default. EuRIS infrastructure and environment
# data (water levels, routes, locks, bridges, notices) is open data, so you
# normally need nothing in this file.

# Optional — override the EuRIS base URL (e.g. for testing or a mirror).
# EURIS_BASE_URL=https://www.eurisportal.eu

# Optional — a bearer token sent to EuRIS for rate-limit / good-citizen
# identification on a hosted instance. NOT required for open data.
# EURIS_TOKEN=
