{
  "name": "binnenvaart-mcp",
  "version": "0.1.0",
  "description": "Open MCP server that brings official EuRIS inland-shipping data (water levels, routes, locks, bridges, notices) into any LLM chat tool.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "binnenvaart-mcp": "dist/stdio.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node dist/stdio.js",
    "dev": "tsc -p tsconfig.json && node dist/stdio.js",
    "dev:http": "tsc -p tsconfig.json && node dist/httpDev.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  }
}
